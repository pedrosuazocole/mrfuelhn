<!DOCTYPE html>
<html lang="es-HN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> | Mr. Fuel v2.0</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .nueva-cat-form {
      padding: 16px 20px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: flex-end;
    }
    .nueva-cat-form .form-group { margin: 0; flex: 1; min-width: 150px; }
    .cat-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px;
      border-bottom: 1px solid #f0f0f0;
      gap: 12px;
      flex-wrap: wrap;
    }
    .cat-row:last-child { border-bottom: none; }
    .cat-info { flex: 1; min-width: 120px; }
    .cat-nombre { font-weight: 600; font-size: 15px; color: #333; }
    .cat-desc   { font-size: 13px; color: #888; margin-top: 2px; }
    @media (max-width: 600px) {
      .cat-row { flex-direction: column; align-items: flex-start; }
      .nueva-cat-form { flex-direction: column; }
      .nueva-cat-form button { width: 100%; }
    }
  </style>
  <%- include('../partials/pwa-head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="main-content">
    <div class="page-header">
      <h1 class="page-title"><i class="fas fa-cog"></i> Categorías de Mantenimiento</h1>
      <a href="/mantenimiento" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Volver
      </a>
    </div>

    <!-- Nueva categoría -->
    <div class="card" style="margin-bottom: 16px;">
      <div class="card-header"><i class="fas fa-plus"></i> Nueva Categoría</div>
      <form method="POST" action="/mantenimiento/admin/categorias" class="nueva-cat-form">
        <div class="form-group">
          <label>Nombre *</label>
          <input type="text" name="nombre" required class="form-control"
                 placeholder="Ej: Generador, Plomería...">
        </div>
        <div class="form-group">
          <label>Descripción</label>
          <input type="text" name="descripcion" class="form-control"
                 placeholder="Descripción breve">
        </div>
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-plus"></i> Agregar
        </button>
      </form>
    </div>

    <!-- Lista de categorías -->
    <div class="card">
      <% if (categorias.length === 0) { %>
        <div style="padding: 30px; text-align: center; color: #aaa;">
          <i class="fas fa-folder-open" style="font-size:40px;opacity:0.3;display:block;margin-bottom:10px;"></i>
          No hay categorías aún.
        </div>
      <% } else { %>
        <% categorias.forEach(cat => { %>
        <div class="cat-row">
          <div class="cat-info">
            <div class="cat-nombre">
              <i class="fas fa-tools" style="color:#ED1C24; margin-right:6px;"></i>
              <%= cat.nombre %>
              <% if (cat.estacion_nombre) { %>
                <span class="badge badge-info" style="margin-left:8px; font-size:11px;">
                  <i class="fas fa-gas-pump"></i> <%= cat.estacion_nombre %>
                </span>
              <% } else { %>
                <span class="badge badge-secondary" style="margin-left:8px; font-size:11px;" title="Aplica a todas las estaciones">
                  <i class="fas fa-globe"></i> Todas
                </span>
              <% } %>
            </div>
            <% if (cat.descripcion) { %>
            <div class="cat-desc"><%= cat.descripcion %></div>
            <% } %>
          </div>
          <div style="display:flex; align-items:center; gap:10px; flex-shrink:0;">
            <span class="badge badge-secondary">
              <i class="fas fa-list"></i> <%= cat.total_items %> ítems
            </span>
            <button class="btn btn-sm btn-warning" title="Editar nombre"
              onclick="abrirEditarCategoria(<%= cat.id %>, '<%= cat.nombre.replace(/'/g, "\\'") %>', '<%= (cat.descripcion||'').replace(/'/g, "\\'") %>')">
              <i class="fas fa-edit"></i>
            </button>
            <a href="/mantenimiento/admin/categorias/<%= cat.id %>/items"
               class="btn btn-sm btn-primary">
              <i class="fas fa-list"></i> Ver Ítems
            </a>
          </div>
        </div>
        <% }); %>
      <% } %>
    </div>
  </main>

  <!-- Modal: Editar Categoría -->
  <div id="modal-editar-categoria-mant" class="modal" style="display: none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Editar Categoría</h2>
        <button class="modal-close" onclick="document.getElementById('modal-editar-categoria-mant').style.display='none'">&times;</button>
      </div>
      <form id="form-editar-categoria-mant">
        <div class="form-group">
          <label>Nombre de la Categoría *</label>
          <input type="text" id="edit-mant-nombre" name="nombre" required class="form-control">
        </div>
        <div class="form-group">
          <label>Descripción</label>
          <textarea id="edit-mant-descripcion" name="descripcion" class="form-control" rows="3"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-editar-categoria-mant').style.display='none'">Cancelar</button>
          <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('../partials/footer') %>
  <script src="/js/main.js"></script>
  <script>
    let editarCategoriaMantId = null;

    function abrirEditarCategoria(id, nombre, descripcion) {
      editarCategoriaMantId = id;
      document.getElementById('edit-mant-nombre').value = nombre;
      document.getElementById('edit-mant-descripcion').value = descripcion;
      document.getElementById('modal-editar-categoria-mant').style.display = 'flex';
    }

    document.getElementById('form-editar-categoria-mant').addEventListener('submit', async (e) => {
      e.preventDefault();
      const nombre = document.getElementById('edit-mant-nombre').value;
      const descripcion = document.getElementById('edit-mant-descripcion').value;
      try {
        const r = await fetch(`/mantenimiento/admin/categorias/${editarCategoriaMantId}/editar`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, descripcion })
        });
        const data = await r.json();
        if (data.success) {
          location.reload();
        } else {
          alert('❌ Error: ' + data.mensaje);
        }
      } catch (err) {
        alert('❌ Error de conexión al actualizar la categoría.');
      }
    });

    // Cerrar modal al hacer clic fuera
    window.addEventListener('click', (e) => {
      if (e.target.classList.contains('modal')) {
        e.target.style.display = 'none';
      }
    });
  </script>
</body>
</html>
